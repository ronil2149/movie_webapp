<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{title}}</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <header class="bg-dark text-white p-3">
        <div class="container">
            <h1 class="text-center">Confirm Deletion</h1>
        </div>
    </header>
    <main class="container mt-4">
        <div class="alert alert-danger text-center">
            <h4>Are you sure you want to delete the movie <strong>{{movie.Title}}</strong>?</h4>
            <p>This action cannot be undone.</p>
            <form action="/api/movies/delete/{{movie._id}}" method="POST" class="d-inline">
                <button type="submit" class="btn btn-danger">Yes, Delete</button>
            </form>
            <a href="/" class="btn btn-secondary">Cancel</a>
        </div>
    </main>
    <footer class="bg-dark text-white text-center py-3 mt-5">
        <p>&copy; 2024 Movie App</p>
    </footer>
</body>
</html>
