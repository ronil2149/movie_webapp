<h1 class="text-center mb-4">All Movies</h1>

<!-- Success Message -->
{{#if successMessage}}
<div class="alert alert-success text-center" role="alert">
    {{successMessage}}
</div>
{{/if}}

<!-- Error Message -->
{{#if errorMessage}}
<div class="alert alert-danger text-center" role="alert">
    {{errorMessage}}
</div>
{{/if}}

<div class="row">
    {{#each movies}}
    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <!-- Movie Poster -->
            <img src="{{Poster}}" class="card-img-top" alt="{{Title}}" style="width: 100%; height: 350px; object-fit: cover; background-color: #f0f0f0;" />

            <!-- Movie Details -->
            <div class="card-body">
                <h5 class="card-title">{{Title}}</h5>
                <p><strong>Year:</strong> {{Year}}</p>
                <p><strong>Genre:</strong> {{Genre}}</p>
                <p><strong>Director:</strong> {{Director}}</p>
                <p><strong>Runtime:</strong> {{Runtime}}</p>
                <p><strong>Actors:</strong> {{Actors}}</p>
                <p><strong>IMDb Rating:</strong> {{imdbRating}}</p>
            </div>

            <!-- Card Footer with Action Buttons -->
            <div class="card-footer text-center">
                <a href="/api/movies/{{_id}}" class="btn btn-info btn-sm">View</a>
                <a href="/api/movies/edit/{{_id}}" class="btn btn-warning btn-sm">Edit</a>
                <button class="btn btn-danger btn-sm" onclick="showDeleteOverlay('{{_id}}', '{{Title}}')">Delete</button>
            </div>
        </div>
    </div>
    {{/each}}
</div>

<!-- Fullscreen Confirmation Overlay -->
<div id="globalDeleteOverlay" class="fullscreen-overlay d-none">
    <div class="confirm-box">
        <p id="deleteMessage"></p>
        <form id="deleteForm" method="POST">
            <button type="submit" class="btn btn-danger">Yes, Delete</button>
        </form>
        <button class="btn btn-secondary" onclick="hideDeleteOverlay()">No</button>
    </div>
</div>

<script>
function showDeleteOverlay(movieId, movieTitle) {
    const overlay = document.getElementById('globalDeleteOverlay');
    const deleteMessage = document.getElementById('deleteMessage');
    const deleteForm = document.getElementById('deleteForm');

    // Update overlay content
    deleteMessage.innerHTML = `Are you sure you want to delete <strong>${movieTitle}</strong>?`;
    deleteForm.action = `/api/movies/delete/${movieId}`;

    // Show overlay
    overlay.classList.remove('d-none');
    document.body.classList.add('blur-active');
}

function hideDeleteOverlay() {
    const overlay = document.getElementById('globalDeleteOverlay');

    // Hide overlay
    overlay.classList.add('d-none');
    document.body.classList.remove('blur-active');
}
</script>
