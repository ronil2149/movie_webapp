<h1 class="text-center mb-4">All Movies</h1>

<!-- Success Message -->
{{#if successMessage}}
<div class="alert alert-success text-center" role="alert">
    {{successMessage}}
</div>
{{/if}}

<!-- Error Message -->
{{#if errorMessage}}
<div class="alert alert-danger text-center" role="alert">
    {{errorMessage}}
</div>
{{/if}}


<!-- Movies Grid -->
<div class="container">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        {{#each movies}}
        <div class="col">
            <div class="card h-100 shadow-sm border-0 rounded-3 movie-card">
                <!-- Movie Poster -->
                <div class="position-relative">
                    <img 
                        src="{{Poster}}" 
                        class="card-img-top img-fluid rounded-top poster-hover" 
                        alt="{{Title}}" 
                        onerror="this.src='https://via.placeholder.com/300x450?text=No+Image+Available';"
                    />
                    <!-- IMDb Rating Badge -->
                    <span class="position-absolute top-0 start-0 badge bg-dark text-white p-2 m-2">
                        {{imdbRating}} <i class="fas fa-star"></i>
                    </span>
                </div>

                <!-- Movie Details -->
                <div class="card-body text-center p-3">
                    <h6 class="card-title fw-bold mb-2">{{Title}}</h6>
                    <p class="mb-1"><span class="badge bg-secondary">{{Genre}}</span></p>
                    <p class="small text-muted mb-1"><strong>Year:</strong> {{Year}}</p>
                    <p class="small text-muted"><strong>Runtime:</strong> {{Runtime}}</p>
                </div>

                <!-- Card Footer with Action Buttons -->
                <div class="card-footer bg-white text-center border-0 py-2">
                    <a href="/api/movies/{{_id}}" class="btn btn-info btn-sm rounded-pill mx-1">
                        <i class="fas fa-eye"></i> View
                    </a>

                    <a href="/api/movies/edit/{{_id}}" class="btn btn-warning btn-sm rounded-pill mx-1">
                        <i class="fas fa-edit"></i> Edit
                    </a>
                    <button 
                        class="btn btn-danger btn-sm rounded-pill mx-1" 
                        onclick="showDeleteOverlay('{{_id}}', '{{Title}}')">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            </div>
        </div>
        {{/each}}
    </div>
</div>



<!-- Fullscreen Confirmation Overlay -->
<div id="globalDeleteOverlay" class="fullscreen-overlay d-none">
    <div class="confirm-box">
        <p id="deleteMessage" class="mb-4 fw-bold"></p>
        <form id="deleteForm" method="POST">
            <button type="submit" class="btn btn-danger rounded-pill">Yes, Delete</button>
        </form>
        <button class="btn btn-secondary rounded-pill mt-2" onclick="hideDeleteOverlay()">No</button>
    </div>
</div>


<script>
function showDeleteOverlay(movieId, movieTitle) {
    const overlay = document.getElementById('globalDeleteOverlay');
    const deleteMessage = document.getElementById('deleteMessage');
    const deleteForm = document.getElementById('deleteForm');

    // Update delete confirmation message and form action
    deleteMessage.innerHTML = `Are you sure you want to delete <strong>${movieTitle}</strong>?`;
    deleteForm.action = `/api/movies/delete/${movieId}`;

    // Show overlay
    overlay.classList.remove('d-none');
    document.body.style.overflow = 'hidden'; // Prevent scrolling
}

function hideDeleteOverlay() {
    const overlay = document.getElementById('globalDeleteOverlay');

    // Hide overlay and restore scroll
    overlay.classList.add('d-none');
    document.body.style.overflow = ''; // Restore scrolling
}

</script>

<style>
/* Custom Card and Image Effects */
.movie-card:hover {
    transform: translateY(-10px);
    transition: all 0.3s ease-in-out;
}
.poster-hover {
    filter: brightness(90%);
    transition: filter 0.3s ease;
}
.poster-hover:hover {
    filter: brightness(110%);
}

/* Fullscreen Overlay */
.fullscreen-overlay {
    position: fixed; /* Fixed positioning to stay on the current viewport */
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.8);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    overflow: hidden;
}

/* Centered Confirmation Box */
.confirm-box {
    background: #fff;
    padding: 2rem;
    border-radius: 10px;
    box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);
    width: 90%;
    max-width: 400px;
    text-align: center;
    transform: translateY(0);
    position: relative;
}


/* Blur Effect on Body */
.blur-active {
    filter: blur(4px);
}
.movie-card {
    transition: all 0.3s ease-in-out;
}

.movie-card:hover {
    transform: translateY(-5px);
}

.poster-hover {
    filter: brightness(90%);
    transition: filter 0.3s ease;
}

.poster-hover:hover {
    filter: brightness(110%);
}

.card-body {
    padding: 0.75rem; 
}

.card-footer {
    padding: 0.5rem;
}
</style>
